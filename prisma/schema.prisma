generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum ContributionStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  OVERDUE_PARTIAL
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REVERSED
  FAILED
}

enum PaymentChannel {
  CASH
  MTN_MOMO
  TELECEL_CASH
  AT_MONEY
  BANK_TRANSFER
  OTHER
}

enum PayoutStatus {
  SCHEDULED
  AUTHORIZED
  DISBURSED
  ACKNOWLEDGED
  PARTIAL
  POSTPONED
}

enum CycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CLOSED
}

enum ResolutionType {
  POSTPONE_PAYOUT
  CARRY_FORWARD
  PARTIAL_PAYOUT
  CUSTOM
}

enum TransactionType {
  CONTRIBUTION
  PAYOUT
  REVERSAL
  ADJUSTMENT
  OPENING_BALANCE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model AdminUser {
  id            String   @id @default(uuid()) @db.Uuid
  supabaseId    String   @unique @map("supabase_id") @db.Uuid
  email         String   @unique
  fullName      String?  @map("full_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  configuredPeriods ContributionPeriod[]
  paymentsVerified Payment[] @relation("PaymentVerifiedBy")
  payoutsAuthorized Payout[] @relation("PayoutAuthorizedBy")
  payoutsDisbursed Payout[] @relation("PayoutDisbursedBy")
  payoutsAcknowledged Payout[] @relation("PayoutAcknowledgedBy")
  ledgerTransactionsCreated LedgerTransaction[] @relation("LedgerTransactionCreatedBy")
  cycleResolutionsApproved CycleResolution[] @relation("CycleResolutionApprovedBy")
  auditLogs AuditLog[]
  notifications Notification[]

  @@map("admin_users")
}

model SavingsGroup {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  contributionAmount   Int      @default(25000) @map("contribution_amount") // GH₵250 in pesewas
  memberCount          Int      @default(4) @map("member_count")
  monthlyTarget        Int      @default(100000) @map("monthly_target") // GH₵1000 in pesewas
  currency             String   @default("GHS")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  members              Member[]
  cycles               SavingsCycle[]
  payments             Payment[]
  ledgerAccounts       LedgerAccount[]
  ledgerTransactions   LedgerTransaction[]

  @@map("savings_groups")
}

model Member {
  id                String       @id @default(uuid()) @db.Uuid
  groupId           String       @map("group_id") @db.Uuid
  group             SavingsGroup @relation(fields: [groupId], references: [id])
  fullName          String       @map("full_name")
  phoneNumber       String       @map("phone_number")
  email             String?
  rotationPosition  Int          @map("rotation_position")
  status            MemberStatus @default(ACTIVE)
  joinedAt          DateTime     @default(now()) @map("joined_at")
  leftAt            DateTime?    @map("left_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  obligations       ContributionObligation[]
  payments          Payment[]
  payouts           Payout[]
  payoutSchedules   PayoutSchedule[]
  cycleResolutions  CycleResolution[]

  @@unique([groupId, rotationPosition])
  @@map("members")
}

model SavingsCycle {
  id              String       @id @default(uuid()) @db.Uuid
  groupId         String       @map("group_id") @db.Uuid
  group           SavingsGroup @relation(fields: [groupId], references: [id])
  cycleNumber     Int          @map("cycle_number")
  startDate       DateTime     @map("start_date")
  endDate         DateTime     @map("end_date")
  status          CycleStatus  @default(DRAFT)
  contributionAmount Int       @map("contribution_amount")
  monthlyTarget   Int          @map("monthly_target")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  completedAt     DateTime?    @map("completed_at")

  periods         ContributionPeriod[]
  payoutSchedules PayoutSchedule[]

  @@unique([groupId, cycleNumber])
  @@map("savings_cycles")
}

model ContributionPeriod {
  id              String   @id @default(uuid()) @db.Uuid
  cycleId         String   @map("cycle_id") @db.Uuid
  cycle           SavingsCycle @relation(fields: [cycleId], references: [id])
  periodNumber    Int      @map("period_number")
  startDate       DateTime @map("start_date")
  dueDate         DateTime @map("due_date")
  closeDate       DateTime @map("close_date")
  deadlineConfiguredBy String @map("deadline_configured_by") @db.Uuid
  deadlineAdministrator AdminUser @relation(fields: [deadlineConfiguredBy], references: [id])
  amount          Int
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  obligations     ContributionObligation[]
  payoutSchedules PayoutSchedule[]
  payments        Payment[]
  resolutions     CycleResolution[]

  @@unique([cycleId, periodNumber])
  @@map("contribution_periods")
}

model ContributionObligation {
  id           String             @id @default(uuid()) @db.Uuid
  periodId     String             @map("period_id") @db.Uuid
  period       ContributionPeriod @relation(fields: [periodId], references: [id])
  memberId     String             @map("member_id") @db.Uuid
  member       Member             @relation(fields: [memberId], references: [id])
  amount       Int
  status       ContributionStatus @default(PENDING)
  paidAmount   Int                @default(0) @map("paid_amount")
  outstandingAmount Int           @default(0) @map("outstanding_amount")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  allocations  PaymentAllocation[]

  @@unique([periodId, memberId])
  @@map("contribution_obligations")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  groupId         String        @map("group_id") @db.Uuid
  group           SavingsGroup  @relation(fields: [groupId], references: [id])
  memberId        String        @map("member_id") @db.Uuid
  member          Member        @relation(fields: [memberId], references: [id])
  periodId        String?       @map("period_id") @db.Uuid
  period          ContributionPeriod? @relation(fields: [periodId], references: [id])
  amount          Int
  channel         PaymentChannel
  reference       String?
  paymentDate     DateTime      @map("payment_date")
  status          PaymentStatus @default(PENDING)
  verifiedAt      DateTime?     @map("verified_at")
  verifiedBy      String?       @map("verified_by") @db.Uuid
  verifier        AdminUser?    @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id])
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  allocations     PaymentAllocation[]
  providerEvents  PaymentProviderEvent[]

  @@unique([groupId, reference])
  @@index([groupId, paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id              String @id @default(uuid()) @db.Uuid
  paymentId       String @map("payment_id") @db.Uuid
  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  obligationId    String @map("obligation_id") @db.Uuid
  obligation      ContributionObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  amount          Int
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([paymentId, obligationId])
  @@map("payment_allocations")
}

model PaymentProviderEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  eventId         String   @map("event_id")
  eventType       String   @map("event_type")
  paymentId       String?  @map("payment_id") @db.Uuid
  payment         Payment? @relation(fields: [paymentId], references: [id])
  payload         Json
  processed       Boolean  @default(false)
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("payment_provider_events")
}

model PayoutSchedule {
  id              String       @id @default(uuid()) @db.Uuid
  cycleId         String       @map("cycle_id") @db.Uuid
  cycle           SavingsCycle @relation(fields: [cycleId], references: [id])
  periodId        String       @map("period_id") @db.Uuid
  period          ContributionPeriod @relation(fields: [periodId], references: [id])
  memberId        String       @map("member_id") @db.Uuid
  member          Member       @relation(fields: [memberId], references: [id])
  rotationPosition Int         @map("rotation_position")
  expectedAmount  Int          @map("expected_amount")
  scheduledDate   DateTime     @map("scheduled_date")
  status          PayoutStatus @default(SCHEDULED)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  payouts         Payout[]

  @@unique([cycleId, rotationPosition])
  @@unique([periodId, rotationPosition])
  @@map("payout_schedules")
}

model Payout {
  id                  String       @id @default(uuid()) @db.Uuid
  scheduleId          String       @map("schedule_id") @db.Uuid
  schedule            PayoutSchedule @relation(fields: [scheduleId], references: [id])
  memberId            String       @map("member_id") @db.Uuid
  member              Member       @relation(fields: [memberId], references: [id])
  expectedAmount      Int          @map("expected_amount")
  authorizedAmount    Int          @map("authorized_amount")
  actualAmount        Int          @default(0) @map("actual_amount")
  outstandingAmount   Int          @default(0) @map("outstanding_amount")
  status              PayoutStatus @default(SCHEDULED)
  channel             PaymentChannel?
  reference           String?
  authorizedAt        DateTime?    @map("authorized_at")
  authorizedBy        String?      @map("authorized_by") @db.Uuid
  authorizer           AdminUser?   @relation("PayoutAuthorizedBy", fields: [authorizedBy], references: [id])
  disbursedAt         DateTime?    @map("disbursed_at")
  disbursedBy         String?      @map("disbursed_by") @db.Uuid
  disburser            AdminUser?   @relation("PayoutDisbursedBy", fields: [disbursedBy], references: [id])
  acknowledgedAt      DateTime?    @map("acknowledged_at")
  acknowledgedBy      String?      @map("acknowledged_by") @db.Uuid
  acknowledger         AdminUser?   @relation("PayoutAcknowledgedBy", fields: [acknowledgedBy], references: [id])
  notes               String?
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@map("payouts")
}

model LedgerAccount {
  id          String      @id @default(uuid()) @db.Uuid
  groupId     String      @map("group_id") @db.Uuid
  group       SavingsGroup @relation(fields: [groupId], references: [id])
  code        String
  name        String
  type        AccountType
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  entries     LedgerEntry[]

  @@unique([groupId, code])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id              String           @id @default(uuid()) @db.Uuid
  groupId         String           @map("group_id") @db.Uuid
  group           SavingsGroup     @relation(fields: [groupId], references: [id])
  reference       String
  transactionType TransactionType  @map("transaction_type")
  description     String
  sourceType      String           @map("source_type")
  sourceId        String           @map("source_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String           @map("created_by") @db.Uuid
  creator         AdminUser        @relation("LedgerTransactionCreatedBy", fields: [createdBy], references: [id])

  entries         LedgerEntry[]

  @@unique([sourceType, sourceId])
  @@unique([groupId, reference])
  @@index([groupId, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id              String         @id @default(uuid()) @db.Uuid
  transactionId   String         @map("transaction_id") @db.Uuid
  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId       String         @map("account_id") @db.Uuid
  account         LedgerAccount  @relation(fields: [accountId], references: [id])
  direction       LedgerDirection
  amount          Int
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("ledger_entries")
}

model CycleResolution {
  id                    String        @id @default(uuid()) @db.Uuid
  periodId              String        @map("period_id") @db.Uuid
  period                ContributionPeriod @relation(fields: [periodId], references: [id])
  resolutionType        ResolutionType @map("resolution_type")
  affectedMemberId      String?       @map("affected_member_id") @db.Uuid
  member                Member?       @relation(fields: [affectedMemberId], references: [id])
  outstandingAmount     Int           @map("outstanding_amount")
  decisionDescription   String        @map("decision_description")
  approvedBy            String        @map("approved_by") @db.Uuid
  approver              AdminUser     @relation("CycleResolutionApprovedBy", fields: [approvedBy], references: [id])
  createdAt             DateTime      @default(now()) @map("created_at")

  @@map("cycle_resolutions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        AdminUser @relation(fields: [userId], references: [id])
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  oldValues   Json?
  newValues   Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  user        AdminUser? @relation(fields: [userId], references: [id])
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  relatedEntityType String? @map("related_entity_type")
  relatedEntityId   String? @map("related_entity_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
